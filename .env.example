# Copy to .env and use absolute paths for external data. Never commit secrets.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8094
# STUDIO_STATE_ROOT=/absolute/path/to/studio/state
# STUDIO_SOURCE_ROOTS=/absolute/path/to/datasets:/absolute/path/to/frozen-packs
# STUDIO_ARCHIVES=/absolute/path/to/previous/workflow-result
# Real execution only on the authorized Linux server. Local use stays editor-only.
# Configure both privately on the authorized Linux execution server only.
# Missing, blank or mismatched declarations keep execution disabled.
# ARCHITECTURE_IQ_KB_AUTHORIZED_HOST=
# ARCHITECTURE_IQ_KB_EXECUTION_HOST=
