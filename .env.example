# Copy to .env and use absolute paths for external data. Never commit secrets.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8094
# STUDIO_STATE_ROOT=/absolute/path/to/studio/state
# STUDIO_SOURCE_ROOTS=/absolute/path/to/datasets:/absolute/path/to/frozen-packs
# STUDIO_ARCHIVES=/absolute/path/to/previous/workflow-result
# Optional read-only observer for an existing KB self-iteration loop.
# Private JSON keys: source_id, host, user, port, root, python,
# poll_seconds (default 5), timeout_seconds (default 15).
# Optional artifact_root is the canonical data directory for reading saved
# question artifacts. Question text is fetched on demand and cached locally;
# changing artifact_root creates an independent observer history/cache.
# The host must match the nonempty private ARCHITECTURE_IQ_KB_AUTHORIZED_HOST.
# Observing does not enable model/GT execution or expose connection settings.
# STUDIO_KB_LOOP_CONFIG=/absolute/path/to/private/kb-loop.json
# Real execution only on the authorized Linux server. Local use stays editor-only.
# Configure both privately on the authorized Linux execution server only.
# Missing, blank or mismatched declarations keep execution disabled.
# ARCHITECTURE_IQ_KB_AUTHORIZED_HOST=
# ARCHITECTURE_IQ_KB_EXECUTION_HOST=
