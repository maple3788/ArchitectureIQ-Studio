      "status": "testable",
      "validity_status": "proposed",
      "dev_evidence": "epoch-9 mixed pairs: 0.92 of 372 decisive pairs, 16/17 lineages. Within mixed pairs whose step sizes are within 2x, R1 held 18/22 and R3 20/21; R2 only 2/22."
    },
    {
      "id": "R6",
      "kind": "architecture",
      "parents": [
