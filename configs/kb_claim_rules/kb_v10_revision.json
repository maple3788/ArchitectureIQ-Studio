              ],
              [
                "width",
                "higher"
              ]
            ]
          },
          "differ": [
            "depth",
            "width"
          ]
        }
      ],
      "status": "testable",
      "validity_status": "proposed",
      "dev_evidence": "controlled_arch_v2 shape sets (2x parameter band): 172/220 decisive pairs, 33/41 lineages; LN+residual 70/75, no-LN+residual 29/35, LN+plain 49/69, plain without LN shallower-wider 43/62."
    },
    {
      "id": "R1",
      "kind": "architecture",
      "parents": [
        "v9 R1 (REPLICATED on controlled_arch_v2)"
      ],
      "text": "In MLPs trained under these short budgets, enabling LayerNorm in the hidden layers lowers test loss when depth, width, activation, residual setting and the whole training setup are held fixed. In controlled tests this held for every learning rate from 3e-5 to 3e-3, all five optimizers, with and without residual connections, and from 256 to 2048 steps.",
      "inject_same": [],
      "rules": [
        {
          "scope": [
            [
              "model_type",
              "eq",
              "mlp"
            ]
          ],
          "same": [
            "opt_key",
            "batch_size",
            "depth",
            "width",
            "activation",
            "residual"
          ],
          "predict": {
            "higher_better": "ln_count"
          }
        }
      ],
      "validity_status": "replicated_in_scope",
      "status": "testable",
      "dev_evidence": "REPLICATED on controlled_arch_v2 (45/47 lineages)."
    },
